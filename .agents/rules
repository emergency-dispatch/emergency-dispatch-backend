## 5. INFRASTRUCTURE LAYER — PATTERNS

### 5.1 DbContext

```csharp
namespace <ProjectName>.Infrastructure.Data;

public class ApplicationDbContext : DbContext
{
    public ApplicationDbContext(DbContextOptions<ApplicationDbContext> options) : base(options) { }
    
    // Khai báo DbSet cho từng entity
    public DbSet<User> Users { get; set; }
    public DbSet<Example> Examples { get; set; }
    // ... thêm DbSet khi thêm entity mới
    
    protected override void OnModelCreating(ModelBuilder modelBuilder)
    {
        base.OnModelCreating(modelBuilder);
        
        // 1. Cấu hình Relationships
        modelBuilder.Entity<Example>()
            .HasOne(e => e.Parent)
            .WithMany(p => p.Children)
            .HasForeignKey(e => e.ParentId)
            .OnDelete(DeleteBehavior.Restrict);  // hoặc Cascade, SetNull
            
        // 2. Cấu hình Decimal precision (BẮT BUỘC cho mọi trường tiền tệ)
        modelBuilder.Entity<Example>()
            .Property(e => e.Price)
            .HasColumnType("decimal(18,2)");
            
        // 3. Cấu hình Index
        modelBuilder.Entity<Example>()
            .HasIndex(e => e.Code)
            .IsUnique();
    }
}
```

### 5.2 Design-time Factory (cho Migration)

```csharp
namespace <ProjectName>.Infrastructure.Data;

public class ApplicationDbContextFactory : IDesignTimeDbContextFactory<ApplicationDbContext>
{
    public ApplicationDbContext CreateDbContext(string[] args)
    {
        var config = new ConfigurationBuilder()
            .SetBasePath(Path.Combine(Directory.GetCurrentDirectory(), "..", "<ProjectName>.API"))
            .AddJsonFile("appsettings.json")
            .Build();
            
        var optionsBuilder = new DbContextOptionsBuilder<ApplicationDbContext>();
        optionsBuilder.UseNpgsql(config.GetConnectionString("DefaultConnection"));
        
        return new ApplicationDbContext(optionsBuilder.Options);
    }
}
```

### 5.3 Repository Implementation

```csharp
namespace <ProjectName>.Infrastructure.Repositories;

public class GenericRepository<T> : IGenericRepository<T> where T : class
{
    protected readonly ApplicationDbContext _context;
    protected readonly DbSet<T> _dbSet;
    
    public GenericRepository(ApplicationDbContext context)
    {
        _context = context;
        _dbSet = context.Set<T>();
    }
    
    public async Task<T?> GetByIdAsync(Guid id) => await _dbSet.FindAsync(id);
    public async Task<T> AddAsync(T entity) { await _dbSet.AddAsync(entity); await _context.SaveChangesAsync(); return entity; }
    public async Task UpdateAsync(T entity) { _dbSet.Update(entity); await _context.SaveChangesAsync(); }
    public async Task DeleteAsync(T entity) { _dbSet.Remove(entity); await _context.SaveChangesAsync(); }
}
```

### 5.4 Infrastructure Service (Cần DB hoặc External API)

Khi service cần truy cập `DbContext` trực tiếp hoặc gọi API bên ngoài (PayOS, Cloudinary, Gmail...) → đặt trong `Infrastructure/Services/`.

```csharp
namespace <ProjectName>.Infrastructure.Services;

public class ExternalPaymentService : IPaymentService
{
    private readonly ApplicationDbContext _db;
    private readonly IOptions<PayOSOptions> _options;
    
    public ExternalPaymentService(ApplicationDbContext db, IOptions<PayOSOptions> options)
    {
        _db = db;
        _options = options;
    }
    
    public async Task<PaymentResult> CreatePaymentAsync(PaymentRequest request)
    {
        // Truy cập DB + gọi external API
    }
}
```

### 5.5 Background Service Pattern

```csharp
namespace <ProjectName>.Infrastructure.Services;

public class CleanupService : BackgroundService
{
    private readonly IServiceScopeFactory _scopeFactory;
    private readonly ILogger<CleanupService> _logger;
    
    public CleanupService(IServiceScopeFactory scopeFactory, ILogger<CleanupService> logger)
    {
        _scopeFactory = scopeFactory;
        _logger = logger;
    }
    
    protected override async Task ExecuteAsync(CancellationToken stoppingToken)
    {
        while (!stoppingToken.IsCancellationRequested)
        {
            try
            {
                using var scope = _scopeFactory.CreateScope();
                var db = scope.ServiceProvider.GetRequiredService<ApplicationDbContext>();
                
                // Nghiệp vụ cleanup...
                
                await db.SaveChangesAsync(stoppingToken);
            }
            catch (Exception ex) { _logger.LogError(ex, "Lỗi khi chạy cleanup"); }
            
            await Task.Delay(TimeSpan.FromMinutes(5), stoppingToken);
        }
    }
}
```

